post {
  url: {{baseUrl}}/api/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "{{resetToken}}",
    "newPassword": "JeszczeInneHaslo1234!"
  }
}

tests {
  test("Ten sam token nie działa drugi raz", () => {
    expect(res.getStatus()).to.equal(400);
  });
}
