meta {
  name: Profil
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/auth/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{jwt}}
}

tests {
  test("200, profil zalogowanego użytkownika", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().email).to.equal(bru.getVar("email"));
  });
}
